#!/usr/bin/env bash
# Links the plugin to a buzz-app clone, the source of the harness modules the
# plugin bundles unchanged. Build tools and bundled libraries are this
# repository's own (package.json and pnpm-lock.yaml, installed with
# `pnpm install --frozen-lockfile`). The clone path differs per machine, so it
# is never written into a tracked file: a gitignored link carries it.
#
#   buzz-app  -> <clone>   (tsconfig paths, vite alias)
#
# Usage: scripts/link-toolchain <buzz-app clone>   (or set BUZZ_APP_DIR)
# Prepare the clone first: check out the revision in src/constants.ts
# (BUZZ_APP_REV). It gives source only, and needs no package install: the type
# check and the bundle read this repository's own packages.
# (Adapted from buzz-plugin-tailscale-host.)
set -euo pipefail

readonly EX_USAGE=64
readonly EX_CONFIG=78
readonly CLONE_LINK=buzz-app
# buzz-app's root package name; anything else is not the clone the plugin
# was written against.
readonly EXPECTED_PACKAGE='"name": "buzz-foundation"'

die() {
	echo "link-toolchain: $2" >&2
	exit "$1"
}

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
clone=${1:-${BUZZ_APP_DIR:-}}
[ -n "$clone" ] || die "$EX_USAGE" "usage: scripts/link-toolchain <buzz-app clone> (or set BUZZ_APP_DIR)"
[ -d "$clone" ] || die "$EX_CONFIG" "not a directory: $clone"
clone=$(cd -- "$clone" && pwd -P)

if ! { [ -f "$clone/package.json" ] && grep -qF "$EXPECTED_PACKAGE" "$clone/package.json"; }; then
	die "$EX_CONFIG" "$clone is not a buzz-app clone (package.json name is not buzz-foundation)"
fi
[ -d "$clone/src" ] || die "$EX_CONFIG" "$clone has no src/ folder"

# A real folder at a link path is someone's work, never replaced.
link() {
	local target=$1 path=$2
	if [ -e "$path" ] && [ ! -L "$path" ]; then
		die "$EX_CONFIG" "$path exists and is not a link; move it away first"
	fi
	ln -sfn -- "$target" "$path"
	echo "linked $path -> $target"
}

link "$clone" "$repo_root/$CLONE_LINK"
